    "E_flag_empty":  {"render": "sdk", "text": null, "is_error": true, "family": "error"},
    "E_generic":     {"render": "sdk", "text": "Error: tool execution failed", "is_error": true, "family": "error"},
    "E_perm":        {"render": "sdk", "text": "Error: permission denied", "is_error": true, "family": "error"},
    "E_timeout":     {"render": "sdk", "text": "Error: request timed out", "is_error": true, "family": "error"},
    "E_remedy":      {"render": "sdk", "text": "Error: request timed out. Retry the same request.", "is_error": true, "family": "error_remedy"},
    "E_text_noflag": {"render": "sdk", "text": "Error: tool execution failed", "is_error": false, "family": "error_textonly"},
